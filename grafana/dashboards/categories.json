    {"type": "row", "id": 100, "title": "HTTP リクエスト (auto)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}},
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "id": 1, "title": "HTTP route 別 RPS",
      "type": "timeseries",
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "fillOpacity": 10, "stacking": {"mode": "normal"}}}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "sum"]}},
      "targets": [{
        "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"laravel-app\", span_name=~\"GET /.*|POST /.*|PUT /.*|DELETE /.*\"}[1m])) by (span_name)",
        "legendFormat": "{{span_name}}"
      }]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
      "id": 2, "title": "HTTP route 別 p95 latency",
      "type": "timeseries",
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max"]}},
      "targets": [{
        "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "histogram_quantile(0.95, sum(rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"laravel-app\", span_name=~\"GET /.*|POST /.*\"}[1m])) by (le, span_name))",
        "legendFormat": "{{span_name}} p95"
      }]
    },

